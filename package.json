{
  "name": "brain-wiki-viz",
  "private": true,
  "version": "0.0.0",
  "description": "The brain-wiki visualizer front end; builds into brain-wiki's src/brainwiki/viz/app/.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/brain-wiki/brain-wiki-viz.git"
  },
  "homepage": "https://github.com/brain-wiki/brain-wiki-viz",
  "bugs": "https://github.com/brain-wiki/brain-wiki-viz/issues",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/notices.mjs && node scripts/build-info.mjs",
    "check": "tsc --noEmit && vitest run && node scripts/check-lock.mjs",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "camera-controls": "2.10.1",
    "d3-hierarchy": "3.1.2",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "preact": "10.26.9",
    "three": "0.177.0"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "3.1.7",
    "@types/mdast": "4.0.4",
    "@types/three": "0.177.0",
    "typescript": "5.8.3",
    "vite": "7.0.6",
    "vitest": "3.2.4"
  }
}
